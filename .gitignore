__pycache__/
*.pyc
# Local engine state (models, packs, logs) lives in ~/Projects/local-llm.
# Per-run bulk: the model's working copy, private homes, raw opencode streams and long prompts.
# The report.json in each run folder keeps scores, timings and per-test results.
results/**/project/
results/**/home/
results/**/grading-home/
results/**/oracle/
results/**/turn-*.prompt.md
results/**/turn-*.stdout.jsonl
# Compatibility shim: basalt bakes its build-time source tree into the binary.
.basalt
